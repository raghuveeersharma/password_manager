# Base URL of the passOP backend API (no trailing slash).
VITE_API_URL=http://localhost:8000/api/v1

# Legacy, import only: the key the old localStorage-only version used to AES-encrypt
# passwords. It is read ONLY by the one-time "Import to my account" button, to decrypt
# entries still saved in this browser. Delete this variable (and src/crypto/legacy.js)
# once your old entries are imported.
# WARNING: any VITE_* value is bundled into the browser JS and is NOT secret.
# VITE_SECRET_KEY=<the value from your old .env>
