# development | production. Production enforces a strong JWT_SECRET and Secure cookies,
# adds HSTS, and disables /docs and /openapi.json.
ENVIRONMENT=development
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=passop
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]
# Set COOKIE_SAMESITE=none (requires COOKIE_SECURE=true) if front and API are on different sites
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Max request body in bytes (vault items are a few KB)
MAX_REQUEST_BYTES=65536
# Behind a reverse proxy, set to the proxy's IP so rate limits see real client IPs.
# FORWARDED_ALLOW_IPS=127.0.0.1
